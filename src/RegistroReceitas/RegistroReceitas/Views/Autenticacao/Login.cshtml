@model RegistroReceitas.ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-warning">
                @TempData["Erro"]
            </div>
        }
        <h4>Entrar</h4>
        <p class="text-muted">Acesse sua conta</p>


        <form asp-action="Login" asp-controller="Autenticacao" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Login" class="form-label">Login</label>
                <input asp-for="Login" class="form-control" placeholder="Seu login" />
                <span asp-validation-for="Login" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Senha" class="form-label">Senha</label>
                <input asp-for="Senha" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Senha" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-dark w-100">Entrar</button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}